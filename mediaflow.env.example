# Optional. MediaFlow now has real sign-up/login (multiple people can create
# their own account from the app's Sign Up page) instead of one shared
# username/password. These two vars only matter for a brand-new install
# with zero accounts yet: if set, they seed exactly one account on first
# boot so you're not locked out before you can reach the Sign Up page. Once
# any account exists, these vars are ignored — safe to remove them after
# your first login.
APP_USERNAME=admin
APP_PASSWORD=CHANGE_THIS_TO_SOMETHING_LONG_AND_RANDOM
PORT=8000

# Only needed if you schedule Instagram posts. Instagram's API needs a public
# URL to fetch the video from, and the background scheduler that publishes
# queued posts has no live browser request to build that URL from (unlike an
# immediate "Publish Now" click) — so it has to be told explicitly.
# Set this to wherever this server is actually reachable from the internet,
# no trailing slash, e.g.:
PUBLIC_BASE_URL=https://your-domain-or-ip.example.com
